<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fixture for crates/sema's union RequireQualifiedAccess grid
       (tests/all/union_rqa_attribute_grid.rs): a referenced type the long
       spelling of the attribute resolves to, in an assembly declaring nothing
       named like the attribute itself. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemaRqaDoubleSuffixFixture</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixture.fs" />
  </ItemGroup>

</Project>
