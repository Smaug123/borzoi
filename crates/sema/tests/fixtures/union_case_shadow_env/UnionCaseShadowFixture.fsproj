<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fixture for the assembly union-case table
       (`crates/sema/tests/all/assembly_union_case_table.rs`): a referenced
       F# library whose namespaces and modules supply every shape that can
       contest FSharp.Core's implicitly opened `Some` / `None` / `Ok` /
       `Error` for a bare name — a non-RQA union reusing a case name, an RQA
       one that must not, a constructible class taking the unqualified
       constructor slot, a union nested in a module, an `[<AutoOpen>]`
       module's union, and a type with same-named statics. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemaUnionCaseShadowFixture</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixture.fs" />
  </ItemGroup>

</Project>
