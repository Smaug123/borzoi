<Project Sdk="Microsoft.NET.Sdk">

  <!-- The fixture behind the unit-of-measure member-typing differential
       (tests/all/infer_measure_erasure_diff.rs): members whose F# types carry
       units of measure that IL erases.

       `Generated.fs` is NOT checked in: it is emitted from the tables in
       crates/sema/tests/all/common/measure_corpus.rs before this project is
       built, so the fixture and the probe's site index cannot drift apart. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemaMeasureFixture</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Generated.fs" />
  </ItemGroup>

</Project>
