<Project Sdk="Microsoft.NET.Sdk">

  <!-- The twin of the module-value fixture (tests/all/infer_assembly_values_diff.rs):
       it declares `Collision.Thing`, as SemaModuleValueFixture does, with a
       member of another type, so a reading that names a type by its path alone
       resolves one assembly's value against the other's type. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemaModuleValueTwin</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
  </ItemGroup>

</Project>
