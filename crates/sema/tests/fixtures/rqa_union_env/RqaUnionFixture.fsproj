<Project Sdk="Microsoft.NET.Sdk">

  <!-- Fixture for crates/sema's union RequireQualifiedAccess grid
       (tests/all/union_rqa_attribute_grid.rs): one union per namespace, each
       under a different spelling of the attribute, so the grid can ask
       whether the assembly reader's verdict is FCS's. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemaRqaUnionFixture</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixture.fs" />
  </ItemGroup>

</Project>
