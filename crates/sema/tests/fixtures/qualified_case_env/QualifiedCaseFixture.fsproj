<Project Sdk="Microsoft.NET.Sdk">

  <!-- The fixture behind the qualified case precedence grid
       (tests/all/qualified_case_precedence_grid.rs): modules and namespaces
       declaring several members named like one union case.

       `Generated.fs` is NOT checked in: it is emitted from the grid's setups
       before this project is built, so the fixture and the probes cannot
       drift apart. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SemaQualifiedCaseFixture</AssemblyName>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Generated.fs" />
  </ItemGroup>

</Project>
