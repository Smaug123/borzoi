<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net10.0 matches the other assembly fixtures, keeping the test
         runner on a single runtime pack. -->
    <TargetFramework>net10.0</TargetFramework>
    <!-- The point of the fixture. Before F# 9 a union's `Is<Case>` properties
         are emitted into metadata but not published as members, so naming one
         cross-assembly is `FS0039`. The emitted rows are indistinguishable from
         a current compiler's, which is why the projection cannot read them. -->
    <LangVersion>8.0</LangVersion>
    <AssemblyName>PreVisibleUnion</AssemblyName>
    <RootNamespace>PreVisibleUnion</RootNamespace>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Library.fs" />
  </ItemGroup>

</Project>
