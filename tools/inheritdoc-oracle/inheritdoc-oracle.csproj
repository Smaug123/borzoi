<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>InheritdocOracle</RootNamespace>
    <AssemblyName>inheritdoc-oracle</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn's IDE `<inheritdoc>` expansion lives in the Workspaces layer
         (`ISymbolExtensions.GetDocumentationComment(..., expandInheritdoc:
         true)`, internal, reached by reflection). 5.3.0 is the version the C#
         sidecar pins, so the oracle needs nothing outside the offline closure
         `nix/deps.json` already carries. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.3.0" />
  </ItemGroup>

</Project>
