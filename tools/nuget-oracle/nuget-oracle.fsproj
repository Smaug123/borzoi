<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>NuGetOracle</RootNamespace>
    <AssemblyName>nuget-oracle</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The libraries whose behaviour crates/nuget reimplements; this tool
         exists so the differential tests can ask them directly. -->
    <PackageReference Include="NuGet.Versioning" Version="7.6.0" />
    <PackageReference Include="NuGet.Frameworks" Version="7.6.0" />
    <PackageReference Include="NuGet.Packaging" Version="7.6.0" />
    <!-- The genuine restore, for the end-to-end `restore` op: NuGet.Commands
         supplies RestoreRunner and both dependency resolvers (the legacy
         walker lives in NuGet.DependencyResolver.Core); NuGet.Protocol the
         local-folder feed. 7.6.0 is the NuGet the .NET 10.0.301 SDK bundles,
         so the op runs the same resolvers `dotnet restore` does. -->
    <PackageReference Include="NuGet.Commands" Version="7.6.0" />
    <PackageReference Include="NuGet.DependencyResolver.Core" Version="7.6.0" />
    <PackageReference Include="NuGet.Protocol" Version="7.6.0" />
  </ItemGroup>

</Project>
